# Copiar a .env (raíz del monorepo). Valores por defecto de Supabase local (`pnpm supabase start`).

# Runtime (API): conexión a través del pooler.
# En Supabase cloud: transaction pooler, puerto 6543, con ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# CLI de Prisma (migrate, studio): conexión directa, sin pooler.
# En Supabase cloud: conexión directa (5432) o session pooler.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
